{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ripple-edge-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "ripple.grimnej.com",
      "custom_domain": true,
    },
  ],
  "secrets": {
    "required": [
      "ACCESS_CODE_HMAC",
      "APP_ORIGIN",
      "LOGIN_PEPPER",
      "SESSION_SIGNING_SECRET",
      "SNOWFLAKE_ACCOUNT_LOCATOR",
      "SNOWFLAKE_HOST",
      "SNOWFLAKE_PRIVATE_KEY",
      "SNOWFLAKE_PUBLIC_KEY_FINGERPRINT",
      "SNOWFLAKE_USER",
    ],
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/out",
    "run_worker_first": ["/api/*"],
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["alerts@grimnej.com"],
    },
  ],
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },
}
